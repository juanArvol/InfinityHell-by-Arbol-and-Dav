package Main.States;

import Display.Managers.DisplayManager;
import Display.Settings.ScalingMode;
import Display.Surface.LayerIndex;
import Display.Surface.RenderFrame;
import Inputs.MouseInput;
import Main.TemporalContext;
import java.awt.Color;
import java.awt.Font;
import java.awt.Graphics2D;
import java.awt.Rectangle;
import java.util.ArrayList;
import java.util.List;

/**
 * Estado de configuración en tiempo real.
 * 
 * ── PROPÓSITO ─────────────────────────────────────────────────────────────
 * Panel de configuración de display que permite experimentar con:
 *   - Resolución virtual (640x360, 960x540, 1280x720, 1920x1080)
 *   - Modo de escalado (FIT, INTEGER_SCALE, PIXEL_PERFECT, STRETCH)
 *   - Interpolación (ON/OFF)
 * 
 * Todos los cambios se aplican INMEDIATAMENTE en runtime sin reiniciar.
 * 
 * ── NAVEGACIÓN ────────────────────────────────────────────────────────────
 * - F4 / ESC: Volver al juego
 * - Click en botones para cambiar configuración
 * 
 * ── ARQUITECTURA ──────────────────────────────────────────────────────────
 * SettingsState mantiene referencia a DisplayManager para aplicar comandos
 * de configuración directamente. Los cambios son persistentes durante la
 * sesión pero no se guardan en disco (pendiente: sistema de config).
 */
public final class SettingsState implements State {

    // ── Referencias ───────────────────────────────────────────────────────
    private final DisplayManager displayManager;
    private final MouseInput mouseInput;
    private final Runnable onExitCallback;  // Callback para volver al juego
    
    // ── Dimensiones virtuales ─────────────────────────────────────────────
    private int virtualWidth;
    private int virtualHeight;
    
    // ── Opciones disponibles ──────────────────────────────────────────────
    // NOTA: La resolución virtual es FIJA y se define en GameOrquester
    // Este panel NO permite cambiarla, solo muestra la actual
    
    private static final ScalingMode[] SCALING_MODES = {
        ScalingMode.FIT,
        ScalingMode.INTEGER_SCALE,
        ScalingMode.PIXEL_PERFECT,
        ScalingMode.STRETCH
    };
    
    // ── Estado actual ─────────────────────────────────────────────────────
    private ScalingMode currentScalingMode = ScalingMode.INTEGER_SCALE;
    private boolean useInterpolation = false;
    
    // ── UI Elements ───────────────────────────────────────────────────────
    private final List<UIButton> buttons = new ArrayList<>();
    private UIButton hoveredButton = null;
    
    // ── Fonts ─────────────────────────────────────────────────────────────
    private Font titleFont;
    private Font normalFont;
    private Font smallFont;
    
    // ── Constructor ───────────────────────────────────────────────────────
    
    public SettingsState(DisplayManager displayManager, MouseInput mouseInput,
                        int virtualWidth, int virtualHeight, Runnable onExitCallback) {
        this.displayManager = displayManager;
        this.mouseInput = mouseInput;
        this.virtualWidth = virtualWidth;
        this.virtualHeight = virtualHeight;
        this.onExitCallback = onExitCallback;
        
        // Detectar configuración actual
        detectCurrentSettings();
        
        // Crear fuentes escaladas según resolución
        createFonts();
        
        // Crear botones de UI
        createButtons();
    }
    
    // ── Creación de fuentes escaladas ─────────────────────────────────────
    
    private void createFonts() {
        // Escalar fuentes según resolución virtual
        int titleSize = (int)(virtualHeight * 0.044f);    // ~32px @ 720p
        int normalSize = (int)(virtualHeight * 0.025f);   // ~18px @ 720p
        int smallSize = (int)(virtualHeight * 0.019f);    // ~14px @ 720p
        
        titleFont = new Font("Arial", Font.BOLD, titleSize);
        normalFont = new Font("Arial", Font.PLAIN, normalSize);
        smallFont = new Font("Arial", Font.PLAIN, smallSize);
    }
    
    // ── Detección de configuración actual ─────────────────────────────────
    
    private void detectCurrentSettings() {
        // Detectar scaling mode actual desde DisplayManager
        currentScalingMode = displayManager.getCurrentScalingMode();
        System.out.println("[SettingsState] 🔍 Scaling mode detectado: " + currentScalingMode.name());
    }
    
    // ── Creación de botones UI ────────────────────────────────────────────
    
    private void createButtons() {
        buttons.clear();
        
        int marginX = (int)(virtualWidth * 0.07f);
        int buttonWidth = (int)(virtualWidth * 0.45f);
        int buttonHeight = (int)(virtualHeight * 0.055f);
        int spacing = (int)(virtualHeight * 0.012f);
        
        // Inicio de botones de scaling mode
        int y = (int)(virtualHeight * 0.35f);
        
        // ── SCALING MODE BUTTONS ──────────────────────────────────────────
        for (ScalingMode mode : SCALING_MODES) {
            buttons.add(new UIButton(
                marginX, y, buttonWidth, buttonHeight,
                mode.name(),
                () -> applyScalingMode(mode)
            ));
            y += buttonHeight + spacing;
        }
        
        y += (int)(virtualHeight * 0.05f);
        
        // ── INTERPOLACIÓN ─────────────────────────────────────────────────
        buttons.add(new UIButton(
            marginX, y, buttonWidth, buttonHeight,
            "Interpolation: OFF",
            this::toggleInterpolation
        ));
        
        y += buttonHeight + (int)(virtualHeight * 0.06f);
        
        // ── BACK BUTTON ───────────────────────────────────────────────────
        buttons.add(new UIButton(
            marginX, y, buttonWidth, buttonHeight,
            "← Back to Game",
            () -> {}
        ));
    }
    
    // ── Acciones de configuración ─────────────────────────────────────────
    
    private void applyScalingMode(ScalingMode mode) {
        currentScalingMode = mode;
        displayManager.requestChangeScalingMode(mode);
        System.out.println("[SettingsState] ✅ Scaling mode cambiado a " + mode.name());
    }
    
    private void toggleInterpolation() {
        useInterpolation = !useInterpolation;
        
        // Aplicar cambio inmediatamente
        // TODO: Implementar toggle de interpolación en DisplayManager
        
        System.out.println("[SettingsState] Interpolación: " + (useInterpolation ? "ON" : "OFF"));
        System.out.println("[SettingsState] ⚠️ Toggle interpolation en runtime pendiente de implementar");
    }
    
    // ── State interface ───────────────────────────────────────────────────
    
    @Override
    public void update(TemporalContext temporalContext) {
        // Actualizar hover de botones según posición del mouse
        int mouseX = (int) mouseInput.mouseVirtualX;
        int mouseY = (int) mouseInput.mouseVirtualY;
        
        hoveredButton = null;
        for (UIButton button : buttons) {
            if (button.contains(mouseX, mouseY)) {
                hoveredButton = button;
                break;
            }
        }
        
        // Detectar clicks con edge detection (solo al presionar, no mantener)
        if (mouseInput.isLeftPressed()) {
            if (hoveredButton != null && !clickProcessed) {
                hoveredButton.action.run();
                clickProcessed = true;
                System.out.println("[SettingsState] 🖱️ Click procesado en: " + hoveredButton.label);
            }
        } else {
            clickProcessed = false;
        }
    }
    
    private boolean clickProcessed = false;
    
    @Override
    public void draw(RenderFrame frame) {
        Graphics2D g = frame.getLayerGraphics(LayerIndex.OVERLAY);
        
        int marginX = (int)(virtualWidth * 0.07f);
        
        // ── Fondo ─────────────────────────────────────────────────────────
        g.setColor(new Color(20, 22, 28));
        g.fillRect(0, 0, virtualWidth, virtualHeight);
        
        // DEBUG: Verificar que las fuentes existan
        if (titleFont == null || normalFont == null || smallFont == null) {
            System.err.println("[SettingsState] ⚠️ ERROR: Fuentes son null, recreando...");
            createFonts();
        }
        
        // ── Header ────────────────────────────────────────────────────────
        int y = (int)(virtualHeight * 0.08f);
        g.setFont(titleFont);
        g.setColor(new Color(230, 230, 240));
        g.drawString("⚙ DISPLAY SETTINGS", marginX, y);
        
        y += (int)(virtualHeight * 0.04f);
        g.setFont(smallFont);
        g.setColor(new Color(140, 145, 160));
        g.drawString("Experimenta con diferentes configuraciones en tiempo real", marginX, y);
        
        y += (int)(virtualHeight * 0.06f);
        
        // ── SECCIÓN: Resolución Virtual (CARRUSEL) ────────────────────────
        g.setFont(normalFont);
        g.setColor(new Color(90, 160, 255));
        g.drawString("RESOLUCIÓN VIRTUAL", marginX, y);
        
        y += (int)(virtualHeight * 0.04f);
        g.setFont(smallFont);
        g.setColor(new Color(120, 125, 140));
        g.drawString("Tamaño del framebuffer virtual", marginX, y);
        
        y += (int)(virtualHeight * 0.06f);
        
        // Mostrar resolución actual
        String resInfo = virtualWidth + "×" + virtualHeight + " px";
        g.setFont(titleFont);
        g.setColor(new Color(255, 220, 100));
        g.drawString(resInfo, marginX, y);
        
        y += (int)(virtualHeight * 0.1f);
        
        // ── SECCIÓN: Scaling Mode ─────────────────────────────────────────
        g.setFont(normalFont);
        g.setColor(new Color(90, 160, 255));
        g.drawString("SCALING MODE", marginX, y);
        
        y += (int)(virtualHeight * 0.03f);
        g.setFont(smallFont);
        g.setColor(new Color(120, 125, 140));
        g.drawString("Cómo se escala el framebuffer a la pantalla física", marginX, y);
        
        y += (int)(virtualHeight * 0.05f);
        
        // Dibujar botones de scaling mode
        for (UIButton button : buttons) {
            String btnLabel = button.label;
            if (btnLabel.equals("FIT") || btnLabel.equals("INTEGER_SCALE") || 
                btnLabel.equals("PIXEL_PERFECT") || btnLabel.equals("STRETCH")) {
                boolean isSelected = btnLabel.equals(currentScalingMode.name());
                button.draw(g, button == hoveredButton, isSelected);
            }
        }
        
        // ── SECCIÓN: Interpolación ────────────────────────────────────────
        UIButton interpButton = null;
        for (UIButton button : buttons) {
            if (button.label.startsWith("Interpolation")) {
                interpButton = button;
                button.label = "Interpolation: " + (useInterpolation ? "ON" : "OFF");
                break;
            }
        }
        
        if (interpButton != null) {
            y = interpButton.bounds.y - (int)(virtualHeight * 0.04f);
            g.setFont(normalFont);
            g.setColor(new Color(90, 160, 255));
            g.drawString("INTERPOLATION", marginX, y);
            
            interpButton.draw(g, interpButton == hoveredButton, false);
        }
        
        // ── Botón Back ────────────────────────────────────────────────────
        for (UIButton button : buttons) {
            if (button.label.contains("Back")) {
                button.draw(g, button == hoveredButton, false);
                break;
            }
        }
        
        // ── Footer ────────────────────────────────────────────────────────
        y = virtualHeight - (int)(virtualHeight * 0.055f);
        g.setFont(smallFont);
        g.setColor(new Color(255, 200, 80));
        g.drawString("💡 INTEGER_SCALE = pixel-art perfecto", marginX, y);
        
        y += (int)(virtualHeight * 0.025f);
        g.setColor(new Color(100, 105, 120));
        g.drawString("FIT puede deformar píxeles si la pantalla no es múltiplo exacto", marginX, y);
        
        // DEBUG: Info de estado
        g.setColor(new Color(100, 100, 100));
        g.drawString("Virtual: " + virtualWidth + "x" + virtualHeight + " | Buttons: " + buttons.size(), marginX, virtualHeight - 5);
    }
    
    @Override
    public void onVirtualDimensionsChanged(int newVirtualWidth, int newVirtualHeight) {
        // Cambio externo (F11, redimensionar ventana, etc.)
        System.out.println("[SettingsState] ═══════════════════════════════════════");
        System.out.println("[SettingsState] 🔄 Cambio EXTERNO de dimensiones");
        System.out.println("[SettingsState]    Anterior: " + virtualWidth + "x" + virtualHeight);
        System.out.println("[SettingsState]    Nueva:    " + newVirtualWidth + "x" + newVirtualHeight);
        
        this.virtualWidth = newVirtualWidth;
        this.virtualHeight = newVirtualHeight;
        
        System.out.println("[SettingsState] 🔤 Recreando fuentes...");
        createFonts();
        
        System.out.println("[SettingsState] 🔘 Recreando botones...");
        createButtons();
        
        System.out.println("[SettingsState] ✅ UI adaptada a nuevas dimensiones");
        System.out.println("[SettingsState] ═══════════════════════════════════════");
    }
    
    @Override
    public void onEnter() {
        System.out.println("[SettingsState] Entrando a configuración");
        // Re-detectar configuración actual al entrar
        detectCurrentSettings();
    }
    
    @Override
    public void onExit() {
        System.out.println("[SettingsState] Saliendo de configuración");
    }
    
    @Override
    public void shutdown() {
        // Sin recursos que liberar
    }
    
    // ── Clases auxiliares ─────────────────────────────────────────────────
    
    private static class UIButton {
        final Rectangle bounds;
        String label;
        final Runnable action;
        
        UIButton(int x, int y, int width, int height, String label, Runnable action) {
            this.bounds = new Rectangle(x, y, width, height);
            this.label = label;
            this.action = action;
        }
        
        boolean contains(int x, int y) {
            return bounds.contains(x, y);
        }
        
        void draw(Graphics2D g, boolean hovered, boolean selected) {
            boolean isArrow = label.equals("◀") || label.equals("▶");
            
            if (isArrow) {
                // Botones de flecha: circulares
                int centerX = bounds.x + bounds.width / 2;
                int centerY = bounds.y + bounds.height / 2;
                int radius = bounds.width / 2;
                
                // Fondo circular
                if (hovered) {
                    g.setColor(new Color(70, 80, 100));
                } else {
                    g.setColor(new Color(45, 50, 65));
                }
                g.fillOval(bounds.x, bounds.y, bounds.width, bounds.height);
                
                // Borde circular
                if (hovered) {
                    g.setColor(new Color(120, 150, 200));
                } else {
                    g.setColor(new Color(70, 80, 100));
                }
                g.drawOval(bounds.x, bounds.y, bounds.width, bounds.height);
                
                // Texto (flecha)
                g.setFont(new Font("Arial", Font.BOLD, (int)(bounds.height * 0.5f)));
                g.setColor(hovered ? new Color(200, 220, 255) : new Color(160, 170, 190));
                int textWidth = g.getFontMetrics().stringWidth(label);
                int textX = centerX - textWidth / 2;
                int textY = centerY + g.getFontMetrics().getAscent() / 2 - 2;
                g.drawString(label, textX, textY);
            } else {
                // Botones normales: rectangulares
                // Fondo del botón
                if (selected) {
                    g.setColor(new Color(50, 140, 60)); // Verde para seleccionado
                } else if (hovered) {
                    g.setColor(new Color(55, 60, 75));
                } else {
                    g.setColor(new Color(35, 40, 52));
                }
                g.fillRect(bounds.x, bounds.y, bounds.width, bounds.height);
                
                // Borde
                if (selected) {
                    g.setColor(new Color(80, 220, 100));
                    // Borde más grueso para seleccionado
                    g.fillRect(bounds.x, bounds.y, bounds.width, 2);
                    g.fillRect(bounds.x, bounds.y + bounds.height - 2, bounds.width, 2);
                    g.fillRect(bounds.x, bounds.y, 2, bounds.height);
                    g.fillRect(bounds.x + bounds.width - 2, bounds.y, 2, bounds.height);
                } else if (hovered) {
                    g.setColor(new Color(100, 120, 160));
                    g.drawRect(bounds.x, bounds.y, bounds.width, bounds.height);
                } else {
                    g.setColor(new Color(60, 65, 80));
                    g.drawRect(bounds.x, bounds.y, bounds.width, bounds.height);
                }
                
                // Texto
                g.setFont(new Font("Arial", Font.BOLD, (int)(bounds.height * 0.4f)));
                if (selected) {
                    g.setColor(new Color(240, 250, 255));
                } else if (hovered) {
                    g.setColor(new Color(200, 210, 240));
                } else {
                    g.setColor(new Color(160, 170, 190));
                }
                
                // Centrar texto
                int textWidth = g.getFontMetrics().stringWidth(label);
                int textX = bounds.x + (bounds.width - textWidth) / 2;
                int textY = bounds.y + (bounds.height + g.getFontMetrics().getAscent()) / 2 - 2;
                g.drawString(label, textX, textY);
            }
        }
    }
}
